#include <DriverKit/IOService.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>
class ScarlettDriver : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient** client) override;
    kern_return_t Perform(uint64_t selector, uint64_t source, uint64_t* output) LOCALONLY;
    kern_return_t ExpandInputs(const uint64_t* input, uint64_t* output) LOCALONLY;
    kern_return_t PerformMix(uint64_t selector, const uint64_t* input, uint64_t* output) LOCALONLY;
    virtual void Notification(OSAction* action, IOReturn status, uint32_t actualByteCount, uint64_t completionTimestamp) TYPE(IOUSBHostPipe::CompleteAsyncIO) QUEUENAME(Notifications);
private:
    kern_return_t Control(uint8_t type, uint8_t request, uint16_t size) LOCALONLY;
    kern_return_t Command(uint32_t command, const uint8_t* payload, uint16_t size, uint8_t* output, uint16_t outputSize) LOCALONLY;
    kern_return_t ReadRoutes(void* routes) LOCALONLY;
};
